# Neon Postgres 連線字串（在 Neon 專案的 Dashboard > Connection string 複製，記得選 "Pooled connection"）
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# 你自己的 Anthropic API Key（在 https://console.anthropic.com 建立，跟 Claude.ai 網頁版的帳號是分開的）
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"

# 自己隨便設一組亂數字串即可，用來保護每日自動清除舊揪團的排程網址，避免被其他人隨便打開觸發
CRON_SECRET="請自己換成一長串亂碼"

# ===== 以下三個只有要用 LINE 官方帳號機器人才需要設定 =====
# 你網站的正式網址（機器人回覆的連結會用這個組出來），結尾不要加斜線
NEXT_PUBLIC_SITE_URL="https://orderfood-five.vercel.app"
# LINE Developers Console > Messaging API 頻道 > Basic settings 的 Channel secret
LINE_CHANNEL_SECRET="xxxxxxxxxxxxxxxx"
# LINE Developers Console > Messaging API 頻道 > Messaging API 分頁的 Channel access token（long-lived）
LINE_CHANNEL_ACCESS_TOKEN="xxxxxxxxxxxxxxxx"
